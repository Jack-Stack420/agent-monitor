[Unit]
Description=Read-only local agent monitor JSON API
After=default.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/youruser/agent-monitor
ExecStart=/usr/bin/python3 -B /home/youruser/agent-monitor/api.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET
ReadOnlyPaths=/home/youruser/agent-monitor
ReadWritePaths=/home/youruser/agent-monitor/data/auth
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
